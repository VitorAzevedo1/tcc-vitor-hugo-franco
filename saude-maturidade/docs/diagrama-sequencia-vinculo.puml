@startuml Diagrama de Sequencia - Vinculo Idoso-Familiar

skinparam sequence {
    ArrowColor #2F5496
    LifeLineBorderColor #2F5496
    ParticipantBorderColor #2F5496
    ParticipantBackgroundColor #E8F0F8
    ActorBorderColor #2F5496
    ActorBackgroundColor #E8F0F8
}

title Diagrama de Sequencia — Vinculo entre Pessoa Idosa e Familiar Autorizado\nSistema de Organizacao de Informacoes de Saude Pessoal na Maturidade

actor "Pessoa Idosa" as idoso
actor "Familiar\nAutorizado" as familiar
participant "Cliente" as client
participant "ConviteController" as conviteCtrl
participant "ConviteService" as conviteSvc
participant "VinculoController" as vinculoCtrl
participant "VinculoService" as vinculoSvc
database "MySQL" as db

== Geracao do codigo de convite ==

idoso -> client : Solicita geracao\nde codigo de convite
activate client

client -> conviteCtrl : POST /api/convites\n(Bearer token da pessoa idosa)
activate conviteCtrl

conviteCtrl -> conviteSvc : gerarCodigo()
activate conviteSvc

conviteSvc -> conviteSvc : Valida perfil do usuario\nautenticado (PESSOA_IDOSA)

loop ate obter codigo inedito
    conviteSvc -> conviteSvc : Gera codigo alfanumerico\nde 8 caracteres
    conviteSvc -> db : SELECT EXISTS\nWHERE codigo = ?
    activate db
    db --> conviteSvc : disponibilidade do codigo
    deactivate db
end

conviteSvc -> db : INSERT INTO convite\n(codigo, idoso_id, status='PENDENTE',\ndata_geracao, data_expiracao)
activate db
db --> conviteSvc : conviteId gerado
deactivate db

conviteSvc --> conviteCtrl : ConviteResponse
deactivate conviteSvc

conviteCtrl --> client : 201 Created\n{ codigo, status: PENDENTE,\ndataExpiracao }
deactivate conviteCtrl

client --> idoso : Exibe o codigo gerado
deactivate client

note over idoso, familiar
  A pessoa idosa repassa o codigo ao familiar
  por canal proprio de confianca (presencialmente,
  telefone ou mensagem). O sistema nao realiza
  envio automatico de notificacoes.
end note

== Aceite do convite e criacao do vinculo ==

familiar -> client : Informa o codigo recebido
activate client

client -> vinculoCtrl : POST /api/vinculos/aceitar\n{ codigo }\n(Bearer token do familiar)
activate vinculoCtrl

vinculoCtrl -> vinculoSvc : aceitarVinculo(codigo)
activate vinculoSvc

vinculoSvc -> vinculoSvc : Valida perfil do usuario\nautenticado (FAMILIAR_AUTORIZADO)

vinculoSvc -> db : SELECT * FROM convite\nWHERE codigo = ?
activate db
db --> vinculoSvc : convite
deactivate db

alt Convite valido, pendente e dentro do prazo
    vinculoSvc -> db : INSERT INTO vinculo\n(idoso_id, familiar_id,\nstatus='ATIVO', data_vinculo)
    activate db
    db --> vinculoSvc : vinculoId gerado
    deactivate db

    vinculoSvc -> db : UPDATE convite\nSET status='UTILIZADO',\ndata_utilizacao = NOW()
    activate db
    db --> vinculoSvc : confirmacao
    deactivate db

    vinculoSvc --> vinculoCtrl : VinculoResponse
    deactivate vinculoSvc

    vinculoCtrl --> client : 201 Created\n{ idosoNome, familiarNome,\nstatus: ATIVO }
    deactivate vinculoCtrl

    client --> familiar : Vinculo estabelecido.\nAcesso de leitura liberado
    deactivate client

else Codigo inexistente
    vinculoSvc --> vinculoCtrl : RecursoNaoEncontradoException
    vinculoCtrl --> client : 404 Not Found\n{ "Codigo de convite invalido" }
    client --> familiar : Exibe mensagem de erro

else Convite ja utilizado ou expirado
    vinculoSvc -> db : UPDATE convite\nSET status='EXPIRADO'\n(apenas se vencido)
    vinculoSvc --> vinculoCtrl : RegraDeNegocioException
    vinculoCtrl --> client : 400 Bad Request\n{ "Este convite nao esta\nmais disponivel" }
    client --> familiar : Exibe mensagem de erro
end

@enduml